# Copy to .env.local for local development. Everything prefixed VITE_ is
# PUBLIC: it is bundled into the browser code. Never put a service-role or
# secret key in a VITE_ variable (the build refuses names containing
# SECRET or SERVICE_ROLE).

# --- Supabase (leave empty to run in local demo mode) ----------------------
VITE_SUPABASE_URL=
# Publishable key (sb_publishable_...) — or the legacy "anon" key.
VITE_SUPABASE_PUBLISHABLE_KEY=
# VITE_SUPABASE_ANON_KEY=

# Public URL of the site, no trailing slash (used for canonical/share links).
VITE_PUBLIC_SITE_URL=http://localhost:5173

# Force demo mode even if Supabase is configured (true/false).
VITE_DEMO_MODE=false

# --- Optional -------------------------------------------------------------
# Comma-separated OAuth providers enabled in Supabase Auth (github,google,...).
VITE_AUTH_OAUTH_PROVIDERS=
# Analytics: off | aggregate (own database, daily counts) | plausible
VITE_ANALYTICS_PROVIDER=off
VITE_PLAUSIBLE_DOMAIN=
# Support: enable the Stripe checkout Edge Function (true) or link elsewhere.
VITE_SUPPORT_CHECKOUT=false
VITE_SUPPORT_EXTERNAL_URL=
# Shown in the privacy policy.
VITE_OPERATOR_NAME=
VITE_CONTACT_EMAIL=

# --- Server-side only (Vercel functions) ----------------------------------
# The /api functions read the public VITE_SUPABASE_* values above; you may
# set SUPABASE_URL / SUPABASE_PUBLISHABLE_KEY instead. No secrets needed.

# --- Supabase Edge Function secrets (set with `supabase secrets set`, NOT here)
# STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, SITE_URL, WORLD_TICK_SECRET
